{
  "name": "jhu-repository-mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Steven J. Miklovic and Jared Galanis",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:generate": "bun run scripts/docs/generate.ts",
    "docs:lint": "markdownlint-cli2",
    "docs:links": "remark --frail --use remark-validate-links .",
    "docs:paths": "bun run scripts/docs/check-paths.ts",
    "docs:public": "bun run scripts/docs/check-public.ts",
    "docs:check": "bun run docs:lint && bun run docs:links && bun run docs:paths && bun run docs:public && bun run docs:generate --check",
    "docs:stale": "bun run scripts/docs/staleness.ts",
    "docs:impact": "bun run scripts/docs/impact.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog:new": "bun run scripts/new-fragment.ts",
    "changelog:build": "bun run scripts/changelog.ts",
    "changelog:preview": "bun run scripts/changelog.ts --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "hono": "^4.7.11",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@fontsource/source-serif-4": "5.3.1",
    "@fontsource/work-sans": "5.3.0",
    "@types/bun": "^1.3.11",
    "fast-check": "4.9.0",
    "markdownlint-cli2": "0.23.3",
    "mermaid": "11.17.2",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "^5.8.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  },
  "engines": {
    "bun": ">=1.3.11"
  }
}
