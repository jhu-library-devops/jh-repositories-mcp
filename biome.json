{
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "include": ["src/**", "config/**", "test/**", "scripts/docs/**", "docs/.vitepress/**"],
    "ignore": ["node_modules", "dist", "infra", "docs/.vitepress/cache", "docs/.vitepress/dist"]
  }
}
